{
  "lab": {
    "base_url": "http://127.0.0.1:8080",
    "extra_allowed_hosts": []
  },
  "collector": {
    "timeout_sec": 5,
    "max_body_chars": 20000,
    "delay_sec": 0.1
  },
  "providers": {
    "ollama": {
      "type": "openai_compat",
      "base_url": "http://localhost:11434/v1",
      "model": "llama3.1:8b",
      "temperature": 0.0
    },
    "openai": {
      "type": "openai_compat",
      "base_url": "https://api.openai.com/v1",
      "model": "YOUR_MODEL_NAME",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 0.0
    },
    "anthropic": {
      "type": "anthropic",
      "model": "claude-sonnet-5-5",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "mock": { "type": "mock" }
  },
  "detector": {
    "type": "rules",
    "provider": "ollama",
    "max_body_chars": 3000
  }
}
